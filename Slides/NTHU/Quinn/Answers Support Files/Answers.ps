    pop

  }{

    /nsetcustomcolor

    {

      /_nCustomColorSD xp

      _nCustomColorSD begin

        4 copy

        /black xd

        /yellow xd

        /magenta xd

        /cyan xd

        4 copy

        0 ne /blackInk xd

        0 ne /yellowInk xd

        0 ne /magentaInk xd

        0 ne /cyanInk xd

