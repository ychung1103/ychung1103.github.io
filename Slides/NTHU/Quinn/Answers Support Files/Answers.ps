  }{

     /knockOut{

      gsave

      false setoverprint

      1 setgray

      0 0 1 1 rectfill

      grestore

    }def

  }ifelse

  /newSpotDict{

    11 dict dup begin

      /nSpots 2 def

      /spot1 7 dict def

      /spot2 7 dict def

   end

  }def

