				TITLE  Cluster Display Program           (Cluster.asm)

				; This program reads the directory of drive A, decodes
				; the file allocation table, and displays the list of
				; clusters allocated to each file.
				; Last update: 9/21/01

				INCLUDE Irvine16.inc
			      C .NOLIST
			      C .LIST
			      C 

				; Attributes specific to 1.44MB diskettes:
 = 0009				FATSectors = 9	; num sectors, first copy of FAT
 = 000E				DIRSectors = 14	; num sectors, root directory
 = 0013				DIR_START = 19	; starting directory sector num

 = 0200				SECTOR_SIZE = 512
 = 0000				DRIVE_A = 0
 = 0001				FAT_START = 1	; starting sector of FAT
 = 0dh,0ah			EOLN equ <0dh,0ah>

 0020				Directory STRUCT
 0000  0008 [				fileName   BYTE 8 dup(?)
        00
       ]
 0008  0003 [				extension  BYTE 3 dup(?)
        00
       ]
 000B  00				attribute  BYTE ?
 000C  000A [				reserved   BYTE 10 dup(?)
        00
       ]
 0016  0000				time       WORD ?
 0018  0000				date       WORD ?
 001A  0000				startingCluster WORD ?
 001C  00000000				fileSize   DWORD ?
				Directory ENDS
 = 0010				ENTRIES_PER_SECTOR = SECTOR_SIZE / (size Directory)

 0000				.data
 0000				heading LABEL byte
