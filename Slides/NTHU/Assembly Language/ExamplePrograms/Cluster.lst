 2E6A 00			driveNumber BYTE ?

 0000				.code
 0000				main PROC
 0000  E8 00AC				call Initialize
 0003  B8 126A R			mov  ax,OFFSET dirbuf
 0006  B8 2E6A R			mov  ax,OFFSET driveNumber
 0009  E8 002C				call LoadFATandDir
 000C  72 26				jc   A3		; quit if we failed
 000E  BE 126A R			mov  si,OFFSET dirbuf		; index into the directory

 0011  80 3C 00			A1:	cmp (Directory PTR [si]).filename,0	; entry never used?
 0014  74 1E				je  A3		; yes: must be the end
 0016  80 3C E5				cmp (Directory PTR [si]).filename,0E5h		; entry deleted?
 0019  74 14				je  A2		; yes: skip to next entry
 001B  80 3C 2E				cmp (Directory PTR [si]).filename,2Eh ; parent directory?
 001E  74 0F				je  A2		; yes: skip to next entry
 0020  80 7C 0B 0F			cmp (Directory PTR [si]).attribute,0Fh ; extended filename?
 0024  74 09				je  A2
 0026  F6 44 0B 18			test (Directory PTR [si]).attribute,18h	; vol or directory name?
 002A  75 03				jnz A2                       		; yes: skip to next entry
 002C  E8 002A				call displayClusters          		; must be a valid entry

 002F  83 C6 20			A2:	add   si,32		; point to next entry
 0032  EB DD				jmp   A1
 0034				A3:	.exit
 0038				main ENDP

				;----------------------------------------------------------
 0038				LoadFATandDir PROC
				; Load FAT and root directory sectors.
				; Receives: nothing
				; Returns: nothing
				;----------------------------------------------------------
 0038  60				pusha
					; Load the FAT
 0039  B0 00				mov  al,DRIVE_A
 003B  B9 0009				mov  cx,FATsectors
 003E  BA 0001				mov  dx,FAT_START
 0041  BB 006A R			mov  bx,OFFSET fattable
 0044  CD 25				int  25h	; read sectors
 0046  83 C4 02				add  sp,2	; pop old flags off stack
					; Load the Directory
 0049  B9 000E				mov  cx,DIRsectors
 004C  BA 0013				mov  dx,DIR_START
 004F  BB 126A R			mov  bx,OFFSET dirbuf
 0052  CD 25				int  25h
 0054  83 C4 02				add  sp,2
 0057  61				popa
 0058  C3				ret
 0059				LoadFATandDir ENDP

				;----------------------------------------------------------
 0059				DisplayClusters PROC
				; Display all clusters allocated to a single file.
				; Receives: SI contains the offset of the directory entry.
				;----------------------------------------------------------
 0059  50				push ax
 005A  E8 0042				call displayFilename	; display the filename
 005D  8B 44 1A				mov  ax,[si+1Ah]	; get first cluster
 0060  3D 0FFF			C1:	cmp  ax,0FFFh	; last cluster?
 0063  74 0E				je   C2	; yes: quit
 0065  BB 000A				mov  bx,10	; choose decimal radix
 0068  E8 0000 E			call WriteDec	; display the number
 006B  E8 000A				call writeSpace	; display a space
 006E  E8 0010				call next_FAT_entry	; returns cluster # in AX
 0071  EB ED				jmp  C1	; find next cluster
 0073  E8 0000 E		C2:	call Crlf
 0076  58				pop  ax
 0077  C3				ret
 0078				DisplayClusters ENDP

				;----------------------------------------------------------
 0078				WriteSpace PROC
				; Write a single space to standard output.
				;----------------------------------------------------------
 0078  50				push ax
 0079  B4 02				mov  ah,2	; function: display character
 007B  B2 20				mov  dl,20h	; 20h = space
 007D  CD 21				int  21h
 007F  58				pop  ax
 0080  C3				ret
 0081				WriteSpace ENDP


				;----------------------------------------------------------
 0081				Next_FAT_entry PROC
				; Find the next cluster in the FAT.
				; Receives: AX = current cluster number
				; Returns: AX = new cluster number
				;----------------------------------------------------------
 0081  53				push bx	; save regs
 0082  51				push cx
 0083  8B D8				mov  bx,ax	; copy the number
 0085  D1 EB				shr  bx,1	; divide by 2
 0087  03 D8				add  bx,ax	; new cluster OFFSET
 0089  8B 97 006A R			mov  dx,fattable[bx]	; DX = new cluster value
 008D  D1 E8				shr  ax,1	; old cluster even?
 008F  72 06				jc   E1	; no: keep high 12 bits
 0091  81 E2 0FFF			and  dx,0FFFh	; yes: keep low 12 bits
 0095  EB 03				jmp  E2
 0097  C1 EA 04			E1:	shr  dx,4	; shift 4 bits to the right
 009A  8B C2			E2:	mov  ax,dx	; return new cluster number
 009C  59				pop  cx	; restore regs
 009D  5B				pop  bx
 009E  C3				ret
 009F				Next_FAT_entry ENDP

				;----------------------------------------------------------
 009F				DisplayFilename PROC
				; Display the file name.
				;----------------------------------------------------------
 009F  C6 44 0B 00			mov  byte ptr [si+11],0 	; SI points to filename
 00A3  8B D6				mov  dx,si
 00A5  E8 0000 E			call Writestring
 00A8  B4 02				mov  ah,2               	; display a space
 00AA  B2 20				mov  dl,20h
 00AC  CD 21				int  21h
 00AE  C3				ret
 00AF				DisplayFilename ENDP

				;----------------------------------------------------------
 00AF				Initialize PROC
				; Set upt DS, clear screen, display a heading.
				;----------------------------------------------------------
 00AF  B8 ---- R			mov  ax,@data
 00B2  8E D8				mov  ds,ax
 00B4  E8 0000 E			call ClrScr
 00B7  BA 0000 R			mov  dx,OFFSET heading	; display program heading
 00BA  E8 0000 E			call Writestring
 00BD  C3				ret
 00BE				Initialize ENDP
				END main
