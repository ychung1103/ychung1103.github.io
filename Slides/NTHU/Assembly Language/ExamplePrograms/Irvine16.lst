 0000				.code
				;------------------------------------------------------
 0000				Clrscr PROC
				;
				; Clears the screen (video page 0) and locates the cursor
				; at row 0, column 0.
				; Receives: nothing
				; Returns:  nothing
				;-------------------------------------------------------
 0000  60				pusha
 0001  B8 0600				mov     ax,0600h    	; scroll window up
 0004  B9 0000				mov     cx,0        	; upper left corner (0,0)
 0007  BA 184F				mov     dx,184Fh    	; lower right corner (24,79)
 000A  B7 07				mov     bh,7        	; normal attribute
 000C  CD 10				int     10h         	; call BIOS
 000E  B4 02				mov     ah,2        	; locate cursor at 0,0
 0010  B7 00				mov     bh,0        	; video page 0
 0012  BA 0000				mov     dx,0	; row 0, column 0
 0015  CD 10				int     10h
 0017  61				popa
 0018  C3				ret
 0019				Clrscr ENDP

				;-----------------------------------------------------
 0019				Crlf PROC
				;
				; Writes a carriage return / linefeed
				; sequence (0Dh,0Ah) to standard output.
				;-----------------------------------------------------
					NewLine	; invoke a macro
 0000			     1	.data
 0000 0D 0A 00		     1	??0000 BYTE 13,10,0
 0019			     1	.code
 0019  52		     1		push dx
 001A  BA 0000 R	     1		mov  dx,OFFSET ??0000
 001D  E8 06D9		     1		call WriteString
 0020  5A		     1		pop  dx
 0021  C3				ret
 0022				Crlf ENDP

				;--------------------------------------------------
 0022				GetCommandTail PROC
				;
				; Gets a copy of the DOS command tail at PSP:80h.
				; Receives: DX contains the offset of the buffer
				; that receives a copy of the command tail.
				; Returns: CF=1 if the buffer is empty; otherwise,
				; CF=0.
				; Last update: 08/26/02
				;--------------------------------------------------
 0022  06			    push es
 0023  60				pusha	; save general registers

 0024  B4 62				mov  ah,62h	; get PSP segment address
 0026  CD 21				int  21h	; returned in BX
 0028  8E C3				mov  es,bx	; copied to ES

 002A  8B F2				mov  si,dx	; point to buffer
 002C  BF 0081				mov  di,81h	; PSP offset of command tail
 002F  B9 0000				mov  cx,0	; byte count
 0032  26: 8A 4D FF			mov  cl,es:[di-1]	; get length byte
 0036  83 F9 00				cmp  cx,0	; is the tail empty?
 0039  74 15				je   L2	; yes: exit
 003B  FC				cld	; no: scan forward
 003C  B0 20				mov  al,20h	; space character
 003E  F3/ AE				repz scasb	; scan for non space
 0040  74 0E				jz   L2	; all spaces found
 0042  4F				dec  di	; non space found
 0043  41				inc  cx

 0044  26: 8A 05		L1: mov  al,es:[di]	; copy tail to buffer
 0047  88 04				mov  [si],al	; pointed to by DS:SI
 0049  46				inc  si
 004A  47				inc  di
 004B  E2 F7				loop L1
 004D  F8				clc	; CF=0 means tail found
 004E  EB 01				jmp  L3

 0050  F9			L2:	stc	; set carry: no command tail
 0051  C6 04 00			L3:	mov byte ptr [si],0	; store null byte
 0054  61				popa	; restore registers
 0055  07				pop es
 0056  C3				ret
 0057				GetCommandTail ENDP

				;----------------------------------------------------------------
 0057				GetMaxXY PROC

				; Returns the current columns (X) and rows (Y) of the console
				; window buffer. These values can change while a program is executing
				; if the user modifies the properties of the application window.
				; Receives: nothing
				; Returns: DH = rows (Y); DL = columns (X)
				; (range of each is 0-255)
				;
				; Added to the library on 10/20/2002, on the suggestion of Ben Schwartz.
				;----------------------------------------------------------------
 0003				.data
 0003 00000000 00 0000		videoInfo VideoInfoStruc <>
       0000 0000
       0008 [
        00 00
       ] 00 00 00 0000 00
       00 00 0000 00 00
       0000 00 0000 00 00
       00
       0003 [
        00
       ] 00 00
       000D [
        00
       ]
 0044 56 69 64 65 6F 20		str1 BYTE "Video function 1Bh is not supported",0dh,0ah,0
       66 75 6E 63 74 69
       6F 6E 20 31 42 68
       20 69 73 20 6E 6F
       74 20 73 75 70 70
       6F 72 74 65 64 0D
       0A 00
 0057				.code
 0057  50				push ax
 0058  53				push bx
 0059  51				push cx

 005A  B4 1B				mov  ah,1Bh	; get video information
 005C  BB 0000				mov  bx,0	; always zero
 005F  1E				push ds
 0060  07				pop  es
 0061  BF 0003 R			mov  di,OFFSET videoInfo
 0064  CD 10				int  10h
 0066  3C 1B				cmp  al,1Bh
 0068  75 0A				jne  notSupported

 006A  8A 36 0025 R			mov  dh,videoInfo.numCharRows
 006E  8A 16 0008 R			mov  dl,BYTE PTR videoInfo.numCharColumns

 0072  EB 06				jmp  finished

 0074				notSupported:
 0074  BA 0044 R			mov dx,OFFSET str1
 0077  E8 067F				call WriteString

 007A				finished:
 007A  59				pop cx
 007B  5B				pop bx
 007C  58				pop ax
 007D  C3				ret
 007E				GetMaxXY ENDP


				;-----------------------------------------------------------
 007E				Delay PROC
				;
				; Create an n-millisecond delay.
				; Receives: EAX = milliseconds
				; Returns: nothing
				; Remarks: May only used under Windows 95, 98, or ME. Does
				; not work under Windows NT, 2000, or XP, because it
				; directly accesses hardware ports.
				; Source: "The 80x86 IBM PC & Compatible Computers" by
				; Mazidi and Mazidi, page 343. Prentice-Hall, 1995.
				;-----------------------------------------------------------

 = 000F4240			MsToMicro = 1000000	; convert ms to microseconds
 = 3AED				ClockFrequency = 15085	; microseconds per tick
 007E				.code
 007E  66| 60				pushad
				; Convert milliseconds to microseconds.
 0080  66| BB 000F4240			mov  ebx,MsToMicro
 0086  66| F7 E3			mul  ebx

				; Divide by clock frequency of 15.085 microseconds,
				; producing the counter for port 61h.
 0089  66| BB 00003AED			mov  ebx,ClockFrequency
 008F  66| F7 F3			div  ebx	; eax = counter
 0092  66| 8B C8			mov  ecx,eax

				; Begin checking port 61h, watching bit 4 toggle
				; between 1 and 0 every 15.085 microseconds.
 0095				L1:
 0095  E4 61				in  al,61h	; read port 61h
 0097  24 10				and al,10h	; clear all bits except bit 4
 0099  38 E0				cmp al,ah	; has it changed?
 009B  74 F8				je  L1	; no: try again
 009D  8A E0				mov ah,al	; yes: save status
 009F  66| 49				dec ecx
 00A1  66| 83 F9 00			cmp ecx,0	; loop finished yet?
 00A5  77 EE				ja  L1

 00A7				quit:
 00A7  66| 61				popad
 00A9  C3				ret
 00AA				Delay ENDP


