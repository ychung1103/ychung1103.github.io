 0141				Gotoxy PROC
				;
				; Sets the cursor position on video page 0.
				; display page.
				; Receives: DH,DL = row, column
				; Returns: nothing
				;---------------------------------------------------
 0141  60				pusha
 0142  B4 02				mov ah,2
 0144  B7 00				mov bh,0
 0146  CD 10				int 10h
 0148  61				popa
 0149  C3				ret
 014A				Gotoxy ENDP


 014A				HexByte PROC
					LOCAL theByte:BYTE
				; Display the byte in AL in hexadecimal
				; Called only by DumpMem. Updated 9/21/01

 0150  60				pusha
 0151  88 46 FF				mov  theByte,al	; save the byte
 0154  B9 0002				mov  cx,2

 0157				HB1:
 0157  C0 46 FF 04			rol  theByte,4
 015B  8A 46 FF				mov  al,theByte
 015E  24 0F				and  al,0Fh
 0160  BB 0262 R			mov  bx,OFFSET xtable
 0163  D7				xlat

					; insert hex char in the buffer
					; and display using WriteString
 0164  A2 0000 R			mov  buffer,al
 0167  C6 06 0001 R 00			mov  [buffer+1],0
 016C  BA 0000 R			mov  dx,OFFSET buffer
 016F  E8 0587				call WriteString

 0172  E2 E3				Loop HB1

 0174  61				popa
					ret
 0179				HexByte ENDP

