 00AA				DumpMem PROC
					   LOCAL unitsize:word, byteCount:word
				;
				; Writes a range of memory to standard output
				; in hexadecimal.
				; Receives: SI = starting OFFSET, CX = number of units,
				;           BX = unit size (1=byte, 2=word, or 4=doubleword)
				; Returns:  nothing
				;---------------------------------------------------
 006A				.data
 006A 20 00			oneSpace   BYTE ' ',0
 006C 0D 0A 44 75 6D 70		dumpPrompt BYTE 13,10,"Dump of offset ",0
       20 6F 66 20 6F 66
       66 73 65 74 20 00
 00B0				.code
 00B0  66| 60				pushad

 00B2  BA 006C R			mov  dx,OFFSET dumpPrompt
 00B5  E8 0641				call WriteString
 00B8  66| 0F B7 C6			movzx eax,si
 00BC  E8 05A6				call  WriteHex
					NewLine
 007E			     1	.data
 007E 0D 0A 00		     1	??0001 BYTE 13,10,0
 00BF			     1	.code
 00BF  52		     1		push dx
 00C0  BA 007E R	     1		mov  dx,OFFSET ??0001
 00C3  E8 0633		     1		call WriteString
 00C6  5A		     1		pop  dx

 00C7  C7 46 FC 0000			mov  byteCount,0
 00CC  89 5E FE				mov  unitsize,bx
 00CF  83 FB 04				cmp  bx,4	; select output size
 00D2  74 07				je   L1
 00D4  83 FB 02				cmp  bx,2
 00D7  74 14				je   L2
 00D9  EB 2D				jmp  L3

 00DB				L1:	; doubleword output
 00DB  66| 8B 04			mov  eax,[si]
 00DE  E8 0584				call WriteHex
					WriteSpace 2
 0081			     1	.data
 0081  0002 [		     1	??0002 BYTE 2 dup(' '),0
        20
       ] 00
 00E1			     1	.code
 00E1  BA 0081 R	     1		mov  dx,OFFSET ??0002
 00E4  E8 0612		     1		call WriteString
 00E7  03 F3				add  si,bx
 00E9  E2 F0				Loop L1
 00EB  EB 46				jmp  L4

 00ED				L2:	; word output
 00ED  8B 04				mov  ax,[si]	; get a word from memory
 00EF  C1 C8 08				ror  ax,8	; display high byte
 00F2  E8 0055				call HexByte
 00F5  C1 C8 08				ror  ax,8	; display low byte
 00F8  E8 004F				call HexByte
	WriteSpace 1	; display 1 space
 0084			     1	.data
 0084  0001 [		     1	??0003 BYTE 1 dup(' '),0
        20
       ] 00
 00FB			     1	.code
 00FB  BA 0084 R	     1		mov  dx,OFFSET ??0003
 00FE  E8 05F8		     1		call WriteString
 0101  03 76 FE				add  si,unitsize	; point to next word
 0104  E2 E7				Loop L2
 0106  EB 2B				jmp  L4

				; Byte output: 16 bytes per line

 0108				L3:
 0108  8A 04				mov  al,[si]
 010A  E8 003D				call HexByte
 010D  FF 46 FC				inc  byteCount
					WriteSpace 1
 0086			     1	.data
 0086  0001 [		     1	??0004 BYTE 1 dup(' '),0
        20
       ] 00
 0110			     1	.code
 0110  BA 0086 R	     1		mov  dx,OFFSET ??0004
 0113  E8 05E3		     1		call WriteString
 0116  46				inc  si

					; if( byteCount mod 16 == 0 ) call Crlf

 0117  BA 0000				mov  dx,0
 011A  8B 46 FC				mov  ax,byteCount
 011D  BB 0010				mov  bx,16
 0120  F7 F3				div  bx
 0122  83 FA 00				cmp  dx,0
 0125  75 08				jne  L3B
					NewLine
 0088			     1	.data
 0088 0D 0A 00		     1	??0005 BYTE 13,10,0
 0127			     1	.code
 0127  52		     1		push dx
 0128  BA 0088 R	     1		mov  dx,OFFSET ??0005
 012B  E8 05CB		     1		call WriteString
 012E  5A		     1		pop  dx
 012F				L3B:
 012F  E2 D7				Loop L3
 0131  EB 00				jmp  L4

 0133				L4:
					NewLine
