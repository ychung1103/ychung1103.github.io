 0665				WriteHex PROC
				;
				; Writes an unsigned 32-bit hexadecimal number to
				; standard output.
				; Input parameters: EAX = the number to write.
				;
				;------------------------------------------------------

 = 0008				DISPLAY_SIZE = 8          ; total number of digits to display

 0272				.data
 0272  0008 [			bufferLH BYTE DISPLAY_SIZE dup(?),0
        00
       ] 00

 0665				.code
 0665  66| 60				pushad               ; save all 32-bit data registers
 0667  B9 0000				mov   cx,0           ; digit counter
 066A  BF 0272 R			mov   di,OFFSET bufferLH
 066D  83 C7 07				add   di,(DISPLAY_SIZE - 1)
 0670  66| BB 00000010			mov   ebx,16	     ; hexadecimal base

 0676				WLH1:
 0676  66| BA 00000000			mov   edx,0          ; clear dividend to zero
 067C  66| F7 F3			div   ebx            ; divide EAX by the radix

 067F  66| 92				xchg  eax,edx        ; swap quotient, remainder
 0681  E8 FFDA				call  AsciiDigit     ; convert AL to ASCII
 0684  88 05				mov   [di],al        ; save the digit
 0686  4F				dec   di             ; back up in buffer
 0687  66| 92				xchg  eax,edx        ; swap quotient, remainder

 0689  41				inc   cx             ; increment digit count
 068A  66| 0B C0			or    eax,eax        ; quotient = 0?
 068D  75 E7				jnz   WLH1           ; no, divide again

					; Insert leading zeros

 068F  B8 0008				mov   ax,DISPLAY_SIZE
 0692  2B C1				sub   ax,cx
 0694  74 08				jz    WLH3           ; display now if no leading zeros required
 0696  8B C8				mov   cx,ax          ; CX = number of leading zeros to insert

 0698				WLH2:
 0698  C6 05 30				mov   byte ptr [di],'0'   ; insert a zero
 069B  4F				dec   di                  ; back up
 069C  E2 FA				loop  WLH2                ; continue the loop

					; Display the digits

 069E				WLH3:
 069E  B9 0008				mov   cx,DISPLAY_SIZE
 06A1  47				inc   di
 06A2  8B D7				mov   dx,di
 06A4  E8 0052				call  WriteString

 06A7  66| 61				popad     ; restore 32-bit registers
 06A9  C3				ret
 06AA				WriteHex ENDP


				;-----------------------------------------------------
 06AA				WriteInt PROC
				;
				; Writes a 32-bit signed binary integer to standard output
				; in ASCII decimal.
				; Receives: EAX = the integer
				; Returns:  nothing
				; Comments: Displays a leading sign, no leading zeros.
				;-----------------------------------------------------
 = 000C				WI_Bufsize = 12
 = 0001				true  =   1
 = 0000				false =   0
 027B				.data
 027B  000C [			buffer_B  BYTE  WI_Bufsize dup(0),0  ; buffer to hold digits
        00
       ] 00
 0288 00			neg_flag  BYTE  ?

 06AA				.code
 06AA  66| 60				 pushad

 06AC  C6 06 0288 R 00			 mov   neg_flag,false    ; assume neg_flag is false
 06B1  66| 0B C0			 or    eax,eax             ; is AX positive?
 06B4  79 08				 jns   WIS1              ; yes: jump to B1
 06B6  66| F7 D8			 neg   eax                ; no: make it positive
 06B9  C6 06 0288 R 01			 mov   neg_flag,true     ; set neg_flag to true

 06BE				WIS1:
 06BE  B9 0000				 mov   cx,0              ; digit count = 0
 06C1  BF 027B R			 mov   di,OFFSET buffer_B
 06C4  83 C7 0B				 add   di,(WI_Bufsize-1)
 06C7  66| BB 0000000A			 mov   ebx,10             ; will divide by 10

 06CD				WIS2:
 06CD  66| BA 00000000			 mov   edx,0              ; set dividend to 0
 06D3  66| F7 F3			 div   ebx                ; divide AX by 10
 06D6  80 CA 30				 or    dl,30h            ; convert remainder to ASCII
 06D9  4F				 dec   di                ; reverse through the buffer
 06DA  88 15				 mov   [di],dl           ; store ASCII digit
 06DC  41				 inc   cx                ; increment digit count
 06DD  66| 0B C0			 or    eax,eax             ; quotient > 0?
 06E0  75 EB				 jnz   WIS2              ; yes: divide again

					 ; Insert the sign.

 06E2  4F				 dec   di	; back up in the buffer
 06E3  41				 inc   cx               	; increment counter
 06E4  C6 05 2B				 mov   byte ptr [di],'+' 	; insert plus sign
 06E7  80 3E 0288 R 00			 cmp   neg_flag,false    	; was the number positive?
 06EC  74 03				 jz    WIS3              	; yes
 06EE  C6 05 2D				 mov   byte ptr [di],'-' 	; no: insert negative sign

 06F1				WIS3:	; Display the number
 06F1  8B D7				mov  dx,di
 06F3  E8 0003				call WriteString

 06F6  66| 61				popad
 06F8  C3				ret
 06F9				WriteInt ENDP


