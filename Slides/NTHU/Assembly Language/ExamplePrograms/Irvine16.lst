 0621  52				push dx
 0622  B4 02				mov  ah,2
 0624  8A D0				mov  dl,al
 0626  CD 21				int  21h
 0628  5A				pop  dx
 0629  58				pop  ax
 062A  C3				ret
 062B				WriteChar ENDP


				;-----------------------------------------------------
 062B				WriteDec PROC
				;
				; Writes an unsigned 32-bit decimal number to
				; standard output. Input parameters: EAX = the
				; number to write.
				;
				;------------------------------------------------------
 0255				.data
				; There will be as many as 10 digits.
 = 000C				BUFFER_SIZE = 12

 0255  000C [			bufferL BYTE BUFFER_SIZE dup(?),0
        00
       ] 00
 0262 30 31 32 33 34 35		xtable BYTE "0123456789ABCDEF"
       36 37 38 39 41 42
       43 44 45 46

 062B				.code
 062B  66| 60				pushad               ; save all 32-bit data registers
 062D  B9 0000				mov   cx,0           ; digit counter
 0630  BF 0255 R			mov   di,OFFSET bufferL
 0633  83 C7 0B				add   di,(BUFFER_SIZE - 1)
 0636  66| BB 0000000A			mov   ebx,10	; decimal number base

 063C				WI1:
 063C  66| BA 00000000			mov   edx,0          ; clear dividend to zero
 0642  66| F7 F3			div   ebx            ; divide EAX by the radix

 0645  66| 92				xchg  eax,edx        ; swap quotient, remainder
 0647  E8 0014				call  AsciiDigit     ; convert AL to ASCII
 064A  88 05				mov   [di],al        ; save the digit
 064C  4F				dec   di             ; back up in buffer
 064D  66| 92				xchg  eax,edx        ; swap quotient, remainder

 064F  41				inc   cx             ; increment digit count
 0650  66| 0B C0			or    eax,eax        ; quotient = 0?
 0653  75 E7				jnz   WI1            ; no, divide again

					; Display the digits (CX = count)
 0655				WI3:
 0655  47				inc   di
 0656  8B D7				mov   dx,di
 0658  E8 009E				call  WriteString

 065B				WI4:
 065B  66| 61				popad	; restore 32-bit registers
 065D  C3				ret
 065E				WriteDec ENDP

				; Convert AL to an ASCII digit.

 065E				AsciiDigit PROC private
