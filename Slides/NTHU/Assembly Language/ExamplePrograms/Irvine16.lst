 0179				DumpRegs PROC
				;
				; Displays EAX, EBX, ECX, EDX, ESI, EDI, EBP, ESP in
				; hexadecimal. Also displays the Zero, Sign, Carry, and
				; Overflow flags.
				; Receives: nothing.
				; Returns: nothing.
