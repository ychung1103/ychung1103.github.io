 05F2				WriteBin PROC
				;
				; Writes a 32-bit integer to standard output in
				; binary format.
				; Receives: EAX = the integer to write
				;------------------------------------------------------
 05F2  60				pusha

 05F3  B9 0008				mov   cx,8	; number of 4-bit groups in EAX
 05F6  BE 0000 R			mov   si,offset buffer

 05F9				WB1:
 05F9  51				push  cx	; save loop count

 05FA  B9 0004				mov   cx,4	; 4 bits in each group
 05FD				WB1A:
 05FD  66| D1 E0			shl   eax,1	; shift EAX left into Carry flag
 0600  C6 04 30				mov   byte ptr [si],'0'	; choose '0' as default digit
 0603  73 03				jnc   WB2	; if no carry, then jump to L2
 0605  C6 04 31				mov   byte ptr [si],'1'	; else move '1' to DL
 0608				WB2:
 0608  46				inc   si
 0609  E2 F2				Loop  WB1A	; go to next bit within group

 060B  C6 04 20				mov   byte ptr [si],' '  ; insert a blank space
 060E  46				inc   si	; between groups
 060F  59				pop   cx	; restore outer loop count
 0610  E2 E7				loop  WB1	; begin next 4-bit group

 0612  C6 04 00				mov  byte ptr [si],0	; insert null byte at end
 0615  66| BA 00000000 R		mov  edx,offset buffer	; display the buffer
 061B  E8 00DB				call WriteString

 061E  61				popa
 061F  C3				ret
 0620				WriteBin ENDP


